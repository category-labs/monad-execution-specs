# Files containing detailed information about the compilation (generated
# by `ocamlc`/`ocamlopt` when invoked using the option `-bin-annot`).
# These files are typically useful for code inspection tools
# (e.g. Merlin).
*.cmt
*.cmti

# ocamlbuild and Dune default working directory
_build/

# ocamlbuild targets
*.byte
*.native

# oasis generated files
setup.data
setup.log

# Merlin configuring file for Vim and Emacs
.merlin

# Dune generated files
*.install
*.aux
*.glob
*.vo
*.vok
*.vos
*.v.d
.coqdeps.d
.lia.cache

# Local OPAM switch
_opam/
.opam-rocq-of-ocaml/

# Pinned Rocq translation tool and generated Gallina
.rocq-tools/
rocq/generated/
.gas-build/
.gas-logs/
.gas-tmp/

# Python workflow caches
__pycache__/
*.pyc

# Blockchain-test fixtures downloaded by scripts/download_mf_tests.sh
test/execution/fixtures/blockchain_tests/mf_tests/
