  "termination_certificates": [
    [
      "lib/ec/algebra.ml",
      "Quotient_field.bezout_coeffs.loop",
      "let '(_, _, divisor, _) := _rocq_state in MonadExecutionSpecs.Termination.Ec.degree_rank (D.(EUCLIDEAN_DOMAIN.degree) divisor)",
      "MonadExecutionSpecs.Termination.Ec.solve_guarded_degree_decrease"
    ],
    [
      "lib/ec/algebra.ml",
      "Polynomial_ring.div_rem.loop",
      "let '(dividend, _) := _rocq_state in MonadExecutionSpecs.Termination.Ec.degree_rank (degree dividend)",
      "MonadExecutionSpecs.Termination.Ec.solve_guarded_degree_decrease"
    ],
    [
      "lib/mpt.ml",
      "Trie.insert",
      "let '(key, depth) := _rocq_state in MonadExecutionSpecs.Termination.TrieDepth.key_depth_rank key depth",
      "MonadExecutionSpecs.Termination.TrieDepth.solve_key_depth_decrease"
    ],
    [
      "lib/mpt.ml",
      "Trie.find",
      "let '(key, depth) := _rocq_state in MonadExecutionSpecs.Termination.TrieDepth.key_depth_rank key depth",
      "MonadExecutionSpecs.Termination.TrieDepth.solve_key_depth_decrease"
    ],
    [
      "lib/mpt.ml",
      "PatriciaTrie.find.loop",
      "let fix tree_size (trie : t) : nat := match trie with | Empty => 1%nat | Branch children _ => S (Stdlib.Lists.List.fold_right (fun child total => (tree_size child + total)%nat) 0%nat children) | Leaf _ => 1%nat | Extension node => S (tree_size node.(t.Extension.subtree)) end in let '(_, trie) := _rocq_state in tree_size trie",
      "MonadExecutionSpecs.Termination.PatriciaTrie.solve_patricia_decrease"
    ],
    [
      "lib/rlp.ml",
      "decode_first",
      "MonadExecutionSpecs.Termination.Rlp.decode_rank _rocq_call",
      "MonadExecutionSpecs.Termination.Rlp.solve_decode_decrease"
    ],
    [
      "lib/string.ml",
      "find_substring.matches_at",
      "let '(i_value, j_value) := _rocq_state in MonadExecutionSpecs.Termination.StringFindSubstring.matches_at_rank str_len substr_len i_value j_value",
      "MonadExecutionSpecs.Termination.StringFindSubstring.solve_matches_at_decrease"
    ],
    [
      "lib/ec/algebra.ml",
      "Polynomial_ring.Impl.of_coeffs.loop",
      "MonadExecutionSpecs.Termination.IntegerLoops.countdown_rank _rocq_state",
      "MonadExecutionSpecs.Termination.IntegerLoops.solve_countdown_decrease"
