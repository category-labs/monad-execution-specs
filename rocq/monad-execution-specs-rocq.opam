opam-version: "2.0"
name: "monad-execution-specs-rocq"
version: "dev"
synopsis: "Toolchain dependencies for translating monad-execution-specs to Rocq"
maintainer: "devnull@example.invalid"
authors: ["Category Labs"]
license: "MIT"
homepage: "https://github.com/category-labs/monad-execution-specs"
bug-reports: "https://github.com/category-labs/monad-execution-specs/issues"

depends: [
  "ocaml" {= "5.4.0"}
  "ocaml-option-flambda"
  "dune" {= "3.23.0"}
  "zarith" {= "1.14"}
  "lens" {= "1.2.5"}
  "digestif" {= "1.3.0"}
  "secp256k1-internal" {= "0.4.0"}
  "alcotest" {= "1.9.1"}
  "qcheck-core" {= "0.27"}
  "qcheck-alcotest" {= "0.27"}
  "yojson" {= "3.0.0"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ctypes" {= "0.24.0"}
  "ctypes-foreign" {= "0.24.0"}
  "angstrom"
  "cmdliner" {= "2.1.1"}
  "csexp"
  "merlin-lib"
  "ocamlfind" {>= "1.5.2"}
  "ocamlformat" {= "0.28.1"}
  "result"
  "rocq-core" {= "9.0.1"}
  "rocq-prover" {= "9.0.0"}
  "rocq-stdlib" {= "9.0.0"}
  "smart-print"
]
