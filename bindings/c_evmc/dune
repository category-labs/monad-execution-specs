(library
 (name c_evmc)
 ; digestif is a virtual library that Dune resolves to either digestif.c (the default) or
 ; digestif.ocaml when linking an executable. Ctypes' intermediate executables don't go through this
 ; resolution step so they fail to link if we don't explicitly include digestif.c as a dependency.
 (libraries digestif.c monad_lib common ctypes ctypes-foreign)
 (ctypes
  (external_library_name evmc)
  (build_flags_resolver
   (vendored
    (c_flags
     (-I %{project_root}/third_party/evmc/include))))
  (deps
   (source_tree %{project_root}/third_party/evmc/include))
  (headers
   (include "evmc/evmc.h"))
  (type_description
   (instance Types)
   (functor C_evmc_template))
  (generated_types C_evmc_generated)
  (generated_entry_point C_evmc_stubs)))
