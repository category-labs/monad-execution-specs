(version 2)

(build
 (all_platforms
  ((action (run pkg-config --print-errors --exists libsecp256k1)))))

(depends
 (all_platforms (conf-pkg-config)))

(depexts
 ((libsecp256k1-dev)
  (or_absorb_undefined_var
   (= %{os_family} debian)
   (= %{os_family} ubuntu)))
 ((dev-libs/libsecp256k1)
  (= %{os_distribution} gentoo))
 ((secp256k1)
  (and_absorb_undefined_var
   (= %{os_distribution} homebrew)
   (= %{os} macos)))
 ((libsecp256k1-git)
  (= %{os_distribution} arch))
 ((libsecp256k1-dev libsecp256k1)
  (= %{os_distribution} alpine))
 ((libsecp256k1-devel libsecp256k1)
  (= %{os_family} fedora))
 ((libsecp256k1-devel)
  (or_absorb_undefined_var
   (and_absorb_undefined_var
    (= %{os_family} suse)
    (>= %{os_version} 16.0))
   (= %{os_family} opensuse)))
 ((libsecp256k1)
  (and_absorb_undefined_var
   (= %{os_family} suse)
   (< %{os_version} 16.0)))
 ((libsecp256k1-devel libsecp256k1)
  (= %{os_distribution} ol))
 ((secp256k1)
  (= %{os} freebsd)))
