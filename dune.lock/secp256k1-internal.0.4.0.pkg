(version 0.4.0)

(build
 (all_platforms
  ((action (run dune build -j %{jobs} -p %{pkg-self:name} @install)))))

(depends
 (all_platforms
  (ocaml conf-gmp dune dune-configurator cstruct bigstring conf-pkg-config)))

(source
 (fetch
