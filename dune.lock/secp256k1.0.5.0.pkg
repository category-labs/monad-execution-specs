(version 0.5.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml dune base stdio dune-configurator base-bigarray conf-secp256k1)))

(source
 (fetch
