(version 0.4.0)

(build
 (run dune build -j %{jobs} -p %{pkg-self:name} @install))

(depends
 ocaml
 conf-gmp
 dune
 dune-configurator
 cstruct
 bigstring
 conf-pkg-config)

(source
 (fetch
